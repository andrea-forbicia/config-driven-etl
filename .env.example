# Copy to .env and fill in. Never commit .env.
GCP_PROJECT_ID=
BQ_DATASET=
DATA_DIR=./data
# Local only: path to a service account key kept outside the repository.
# Leave empty to use `gcloud auth application-default login`.
# Read by the Google SDK, not by the pipeline, and not loaded from .env:
# export it in your shell if you need it.
GOOGLE_APPLICATION_CREDENTIALS=
