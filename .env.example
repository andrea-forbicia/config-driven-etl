# Copy to .env and fill in. Never commit .env.
GCP_PROJECT_ID=
BQ_DATASET=
DATA_DIR=./data
# Optional: table in BQ_DATASET that gets one row per pipeline command.
BQ_AUDIT_TABLE=
# Optional: json (default) for log collectors, pretty for a terminal.
LOG_FORMAT=
# Local only: path to a service account key kept outside the repository.
# Leave empty to use `gcloud auth application-default login`.
# Read by the Google SDK, not by the pipeline, and not loaded from .env:
# export it in your shell if you need it.
GOOGLE_APPLICATION_CREDENTIALS=
